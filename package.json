{
  "name": "@lionad/dv",
  "version": "0.1.0",
  "description": "npm scripts shortcut launcher with runtime plugin hooks and built-in killport",
  "license": "MIT",
  "keywords": [
    "dev",
    "cli",
    "npm-scripts",
    "kill-port",
    "monorepo"
  ],
  "os": [
    "darwin"
  ],
  "type": "module",
  "bin": {
    "dv": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "vp pack src/cli.ts --dts false",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cac": "^7.0.0",
    "hookable": "^6.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.6",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
